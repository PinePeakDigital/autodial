{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2022",
    "types": ["@cloudflare/workers-types", "jest"],
    "skipLibCheck": true
  },
  "compileOnSave": true,
  "include": [
    "src"
  ],
}
