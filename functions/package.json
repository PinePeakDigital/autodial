{
  "name": "functions",
  "main": "src/index.ts",
  "scripts": {
    "lint": "eslint .",
    "build": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "npx jest",
    "test:watch": "npx jest --watch"
  },
  "jest": {
    "projects": [
      {
        "displayName": "functions",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "resetMocks": true,
        "roots": [
          "<rootDir>"
        ],
        "testPathIgnorePatterns": [
          "<rootDir>/node_modules/",
          "<rootDir>/lib/"
        ]
      }
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@sentry/cloudflare": "^8.47.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^9.39.5",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "wrangler": "^4.135.0"
  },
  "private": true,
  "overrides": {
    "sharp": "^0.35.4"
  }
}
